# NexusDev configuration template.
# Copy to .env and fill in locally. NEVER commit the filled-in file.
# Values here MUST stay empty — this file is public.

# Node 1 — Claude (The Brain)
ANTHROPIC_API_KEY=

# Node 4 — Hermes (local LLM). Optional: router degrades to cloud-only.
HERMES_ENDPOINT=
HERMES_MODEL=

# Node 7 — Comet (telemetry). Optional: router degrades to local JSONL.
COMET_API_KEY=
COMET_PROJECT=

# Router behaviour
# Command the router hands off to. Empty means nothing executes and the task
# returns to ready.
NEXUS_EXECUTOR_CMD=
# Task owners this router may execute, comma separated. Defaults to aider.
# A task owned by cursor, claude, opencode or human belongs to another path.
NEXUS_ROUTABLE_OWNERS=
NEXUS_DRY_RUN=
NEXUS_MAX_RUNS_PER_HOUR=
