# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.key
*.pem
*.p12
credentials.json

# --- Comet telemetry output (schema is documented in MASTER_PLAN.md) ---
metrics/*.jsonl

# --- Local model weights ---
models/
*.gguf
*.safetensors

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# --- Aider ---
.aider*
!.aider.conf.yml.example

# --- Other tools' scratch worktrees ---
# Registered git worktrees are already excluded from status, but an abandoned
# one left behind as plain files would otherwise be committed wholesale.
.kilo/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
*.swp
